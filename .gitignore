
# ==========================================
# SMARTSCRIBE - GIT IGNORE
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local AI models
models/*
!models/.gitkeep

*.gguf
*.safetensors
*.pth
*.pt
*.bin

# User-generated SmartScribe data
recordings/*
notes/*
data/*
workspaces/*

# Preserve empty folders
!recordings/.gitkeep
!notes/.gitkeep
!data/.gitkeep
!workspaces/.gitkeep

# Databases
*.db
*.sqlite
*.sqlite3

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# Local browser profiles and caches
data/app_profile/
cache/
.cache/

# Test coverage
.coverage
.coverage.*
htmlcov/
.tox/

# Operating system files
.DS_Store
Thumbs.db

# VS Code local settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Build and distribution files
dist/
build/
*.egg-info/

# Local testing artifacts
scratch/
